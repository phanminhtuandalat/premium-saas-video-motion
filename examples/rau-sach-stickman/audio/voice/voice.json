  {
   "i": 4,
   "file": "audio/voice/line04.wav",
   "dur": 1.768,
   "spoken": "Vậy họ tin vào điều gì nhất?"
  },
  {
   "i": 5,
   "file": "audio/voice/line05.wav",
   "dur": 4.53,
   "spoken": "Quy trình sản xuất được bảo đảm, bảy mươi mốt phẩy hai phần trăm chọn"
  },
  {
   "i": 6,
   "file": "audio/voice/line06.wav",
   "dur": 1.937,
   "spoken": "Kế đến là Việt Gáp"
