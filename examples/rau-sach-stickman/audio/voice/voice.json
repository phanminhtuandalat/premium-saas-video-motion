   "spoken": "Ai cũng muốn ăn rau sạch."
  },
  {
   "i": 1,
   "file": "audio/voice/line01.wav",
   "dur": 2.28,
   "spoken": "Nhưng người mua vẫn còn do dự?"
  },
  {
   "i": 2,
   "file": "audio/voice/line02.wav",
   "dur": 4.596,
   "spoken": "Ở thành phố Hồ Chí Minh, tám mươi sáu phần trăm người được hỏi"
  },
  {
   "i": 3,
   "file": "audio/voice/line03.wav",
   "dur": 3.373,
   "spoken": "sẵn sàng trả thêm năm đến mười phần trăm"
